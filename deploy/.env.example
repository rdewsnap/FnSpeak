# Copy to deploy/.env for docker compose. Only the first three are required.

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
FNSPEAK_SECRET=
# Where people reach the server; used in emailed links.
FNSPEAK_BASE_URL=http://localhost:8080

# Without SMTP, sign-in links are printed in the server log.
FNSPEAK_SMTP_HOST=
FNSPEAK_SMTP_PORT=587
FNSPEAK_SMTP_USERNAME=
FNSPEAK_SMTP_PASSWORD=
FNSPEAK_SMTP_FROM=

# Sign in with Google, next to the emailed link. Leave empty to turn it off.
# Create an OAuth client (web application) in Google Cloud and allow the
# redirect URI <FNSPEAK_BASE_URL>/v1/auth/google/callback.
FNSPEAK_GOOGLE_CLIENT_ID=
FNSPEAK_GOOGLE_CLIENT_SECRET=

# Hosted cleanup and summaries. Leave the key empty to turn them off.
FNSPEAK_LLM_PROVIDER=anthropic
FNSPEAK_LLM_API_KEY=
FNSPEAK_LLM_MODEL=claude-haiku-5-5
# For OpenAI's gpt-6-luna instead:
# FNSPEAK_LLM_PROVIDER=openai
# FNSPEAK_LLM_BASE_URL=https://api.openai.com/v1
# FNSPEAK_LLM_MODEL=gpt-6-luna
# FNSPEAK_LLM_REASONING_EFFORT=none
