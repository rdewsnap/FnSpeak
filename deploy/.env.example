# Copy to deploy/.env for docker compose. Only the first three are required.

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
FLOWSTATE_SECRET=
# Where people reach the server; used in emailed links.
FLOWSTATE_BASE_URL=http://localhost:8080

# Without SMTP, sign-in links are printed in the server log.
FLOWSTATE_SMTP_HOST=
FLOWSTATE_SMTP_PORT=587
FLOWSTATE_SMTP_USERNAME=
FLOWSTATE_SMTP_PASSWORD=
FLOWSTATE_SMTP_FROM=

# Hosted cleanup and summaries. Leave the key empty to turn them off.
FLOWSTATE_LLM_PROVIDER=anthropic
FLOWSTATE_LLM_API_KEY=
FLOWSTATE_LLM_MODEL=claude-haiku-5-5
