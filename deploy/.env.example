# Copy to deploy/.env for docker compose. Only the first three are required.

POSTGRES_PASSWORD=change-me
# openssl rand -hex 32
FNSPEAK_SECRET=
# Where people reach the server; used in emailed links.
FNSPEAK_BASE_URL=http://localhost:8080

# Without SMTP, sign-in links are printed in the server log.
FNSPEAK_SMTP_HOST=
FNSPEAK_SMTP_PORT=587
FNSPEAK_SMTP_USERNAME=
FNSPEAK_SMTP_PASSWORD=
FNSPEAK_SMTP_FROM=

# Hosted cleanup and summaries. Leave the key empty to turn them off.
FNSPEAK_LLM_PROVIDER=anthropic
FNSPEAK_LLM_API_KEY=
FNSPEAK_LLM_MODEL=claude-haiku-5-5
